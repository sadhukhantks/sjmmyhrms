<?xml version="1.0" encoding="utf-8"?>
<!-- Blue spreadsheet cell (header columns + machine-name column): blue fill with
     a light-blue 1dp gridline on the right and bottom edges. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#90CAF9" />
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <color android:color="#1565C0" />
    </item>
</layer-list>
