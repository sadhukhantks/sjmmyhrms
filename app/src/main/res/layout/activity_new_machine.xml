<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F2">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        app:titleTextColor="@color/white">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Machine Entry"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ═══ FILTER CARD ═══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Machine Summary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1E1E1E"
                        android:layout_marginBottom="12dp" />

                    <!-- ROW: Date | Department -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <LinearLayout
                                android:id="@+id/btnEntryDate"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar"
                                    android:layout_marginEnd="6dp"
                                    app:tint="#555555"/>
                                <TextView
                                    android:id="@+id/tvEntryDate"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="#1E1E1E"
                                    android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Department"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <Spinner
                                android:id="@+id/spDepartment"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW: Shed -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shed"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="3dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleShed"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/btnShedOld">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShedOld"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="0dp"
                            android:text="Old Shed" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShedNew"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="0dp"
                            android:text="New Shed" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══ GRID CARD ═══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Machines"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1E1E1E"/>

                        <ImageView
                            android:id="@+id/ivHandsReport"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_report"
                            android:scaleType="centerInside"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Hands Report"
                            app:tint="#1565C0"/>

                        <ImageView
                            android:id="@+id/ivHandsStd"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_compare"
                            android:scaleType="centerInside"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Actual vs Std Hands Report"
                            app:tint="#C2185B"/>
                    </LinearLayout>

                    <!-- Spreadsheet grid: header + rows share one outer border;
                         each cell draws its own right/bottom gridline. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_grid_outer">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="3" android:text="Machine"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="2" android:text="A1"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="2" android:text="A2"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="2" android:text="B1"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="2" android:text="B2"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="2" android:text="C"
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1.4" android:text=""
                                android:background="@drawable/bg_grid_cell_blue"
                                android:textColor="#FFFFFF" android:textStyle="bold"
                                android:textSize="12sp" android:gravity="center"/>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMachines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGridEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select a department to load machines"
                        android:textColor="#999999"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="16dp"/>

                    <ProgressBar
                        android:id="@+id/pbGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
