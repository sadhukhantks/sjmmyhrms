<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F2">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        app:titleTextColor="@color/white">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jute Mukam Received"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ═══ ENTRY CARD ═══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Title + Recvd No selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jute Mukam Received"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1E1E1E" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recvd No"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <Spinner
                                android:id="@+id/spRecvdNo"
                                android:layout_width="150dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW 1: Date | Party -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Received Date"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <LinearLayout
                                android:id="@+id/btnEntryDate"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar"
                                    android:layout_marginEnd="6dp"
                                    app:tint="#555555"/>
                                <TextView
                                    android:id="@+id/tvEntryDate"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="#1E1E1E"
                                    android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Party *"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <AutoCompleteTextView
                                android:id="@+id/acParty"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="Select party"
                                android:inputType="text"
                                android:completionThreshold="1"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW 2: Mukam | Quality -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mukam"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <AutoCompleteTextView
                                android:id="@+id/acMukam"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="Select mukam"
                                android:inputType="text"
                                android:completionThreshold="1"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quality"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <AutoCompleteTextView
                                android:id="@+id/acQuality"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="Select quality"
                                android:inputType="text"
                                android:completionThreshold="1"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW 3: Gross | Tare | Net -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="3"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gross Wt"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etGrossWt"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="0.000"
                                android:inputType="numberDecimal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"
                                android:imeOptions="actionNext"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tare Wt"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etTareWt"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="0.000"
                                android:inputType="numberDecimal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"
                                android:imeOptions="actionNext"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Net Wt"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etNetWt"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_readonly"
                                android:hint="0.000"
                                android:inputType="numberDecimal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"
                                android:focusable="false"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW 4: Geo location | Place -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="2"
                        android:layout_marginBottom="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Geo Location"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etGeoLocation"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_readonly"
                                android:hint="auto-captured"
                                android:inputType="text"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="12sp"
                                android:textColor="#1E1E1E"
                                android:focusable="false"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Place"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etGeoPlace"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_readonly"
                                android:hint="auto-captured"
                                android:inputType="text"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="12sp"
                                android:textColor="#1E1E1E"
                                android:focusable="false"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRefreshLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↻ Refresh location"
                        android:textSize="12sp"
                        android:textColor="#1565C0"
                        android:textAllCaps="false"
                        android:background="@android:color/transparent"
                        android:paddingStart="0dp"
                        android:layout_marginBottom="6dp"/>

                    <!-- Remarks -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remarks"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>
                    <EditText
                        android:id="@+id/etRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="@drawable/bg_input_rounded_light"
                        android:hint="Remarks"
                        android:inputType="textMultiLine|textCapSentences"
                        android:gravity="top"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textSize="13sp"
                        android:textColor="#1E1E1E"
                        android:layout_marginBottom="12dp"/>

                    <!-- Photo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photo"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <ImageView
                        android:id="@+id/ivPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_input_readonly"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:contentDescription="Mukam photo"
                        android:visibility="gone"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:id="@+id/tvPhotoEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No photo"
                        android:textColor="#999999"
                        android:textSize="12sp"
                        android:padding="6dp"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <Button
                            android:id="@+id/btnTakePhoto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:text="Take Photo"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            android:backgroundTint="#00838F"
                            android:layout_marginEnd="6dp"/>
                        <Button
                            android:id="@+id/btnRemovePhoto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:text="Remove"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            android:backgroundTint="#B0BEC5"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Save"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1565C0"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
